# Bibliothèques système Windows dont libxul a besoin et que Firefox lie
# depuis browser/components/shell, que Core ne construit pas
# (propsys : VariantCompare, utilisé par accessible/windows/uia).
SOURCES += ["WinLibs.cpp"]

OS_LIBS += ["propsys"]

FINAL_LIBRARY = "xul"
