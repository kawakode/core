EXTRA_COMPONENTS += [
    "l10n-registry.manifest",
]

DIRS += [
    "base",
    "components",
    "extensions",
    "modules",
    "app",
]

if CONFIG["OS_ARCH"] == "WINNT":
    DIRS += ["winlibs"]

DIST_SUBDIR = "app"
export("DIST_SUBDIR")

DEFINES["APP_VERSION"] = CONFIG["MOZ_APP_VERSION"]

# Déclaré ici pour hériter de DIST_SUBDIR, qui est remis à zéro dans app/.
JS_PREFERENCE_PP_FILES += [
    "app/profile/core.js",
]

# Permissions par défaut : addons.mozilla.org peut installer des extensions.
FINAL_TARGET_FILES.defaults += [
    "app/permissions",
]
