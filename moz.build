EXTRA_COMPONENTS += [
    "l10n-registry.manifest",
]

DIRS += [
    "base",
    "app",
]

DIST_SUBDIR = "app"
export("DIST_SUBDIR")

DEFINES["APP_VERSION"] = CONFIG["MOZ_APP_VERSION"]

# Déclaré ici pour hériter de DIST_SUBDIR, qui est remis à zéro dans app/.
JS_PREFERENCE_FILES += [
    "app/profile/core.js",
]
