# Lanceur natif, version allégée de browser/app/moz.build.
# Linux d'abord ; les parties Windows réutilisent le launcher de Firefox,
# le bundle macOS reste à faire.

GeckoProgram(CONFIG["MOZ_APP_NAME"], linkage="standalone")

# application.ini.h change à chaque build (build ID) : on l'isole dans un
# petit fichier pour ne pas recompiler nsCoreApp.cpp à chaque fois.
SOURCES += [
    "ApplicationData.cpp",
    "nsCoreApp.cpp",
]

# Ni le binaire ni ses fichiers ne vont dans dist/bin/app.
DIST_SUBDIR = ""

LOCAL_INCLUDES += [
    "!/build",
    "/toolkit/xre",
    "/xpcom/base",
    "/xpcom/build",
]

if CONFIG["CC_TYPE"] == "clang-cl":
    WIN32_EXE_LDFLAGS += ["-ENTRY:wmainCRTStartup"]

if CONFIG["OS_ARCH"] == "WINNT":
    DIRS += ["/browser/app/winlauncher"]
    USE_LIBS += ["winlauncher"]
    LOCAL_INCLUDES += ["/browser/app/winlauncher"]
    OS_LIBS += ["advapi32", "shell32", "uuid"]
    DELAYLOAD_DLLS += [
        "advapi32.dll",
        "oleaut32.dll",
        "ole32.dll",
        "rpcrt4.dll",
        "shell32.dll",
        "version.dll",
    ]
    if CONFIG["CC_TYPE"] == "clang-cl":
        libpath_flag = "-LIBPATH:"
    else:
        libpath_flag = "-L"
    # winlauncher est construit sous browser/app/, pas sous core/app/.
    WIN32_EXE_LDFLAGS += [
        libpath_flag + TOPOBJDIR + "/browser/app/winlauncher/freestanding"
    ]
    LINK_FLAGS["CETCOMPAT"] = []

if CONFIG["OS_ARCH"] == "Darwin":
    OS_LIBS += ["-framework CoreFoundation"]

if CONFIG["MOZ_SANDBOX"] and CONFIG["OS_ARCH"] == "WINNT":
    LOCAL_INCLUDES += [
        "/security/sandbox/chromium",
        "/security/sandbox/chromium-shim",
    ]
    USE_LIBS += ["sandbox_s"]
    OS_LIBS += ["shlwapi", "winmm"]
    DELAYLOAD_DLLS += [
        "winmm.dll",
        "user32.dll",
        "userenv.dll",
        "usp10.dll",
    ]

DisableStlWrapping()

if CONFIG["HAVE_CLOCK_MONOTONIC"]:
    OS_LIBS += CONFIG["REALTIME_LIBS"]

if CONFIG["MOZ_ASAN"] or CONFIG["MOZ_DEBUG"]:
    WINCONSOLE = True
else:
    WINCONSOLE = False
