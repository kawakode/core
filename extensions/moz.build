JAR_MANIFESTS += ["jar.mn"]

EXTRA_COMPONENTS += [
    "extensions-core.manifest",
]

# Fenêtres surgissantes des boutons d'extensions (PanelPopup), reprises de
# Firefox.
EXTRA_JS_MODULES += [
    "/browser/components/extensions/ExtensionPopups.sys.mjs",
]
