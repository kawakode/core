DIRS += ["locales"]

JAR_MANIFESTS += ["jar.mn"]

DIST_SUBDIR = "core"
export("DIST_SUBDIR")

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
    FINAL_TARGET_FILES.chrome.icons.default += [
        "default128.png",
        "default16.png",
        "default32.png",
        "default48.png",
        "default64.png",
    ]
