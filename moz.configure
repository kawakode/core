# Briques de toolkit/ que Core active. Tout ce que browser/moz.configure
# active en plus (Sync, Normandy, télémétrie de santé, migrateurs…) reste éteint.
imply_option("MOZ_PLACES", True)

imply_option("MOZ_APP_VENDOR", "Core")
# Identifiant de Firefox : les extensions d'addons.mozilla.org vérifient leur
# compatibilité contre cet ID et ce numéro de version.
imply_option("MOZ_APP_ID", "{ec8030f7-c20a-464f-9b0e-13a3a9e97384}")
imply_option("--with-app-basename", "Core")
imply_option("BROWSER_CHROME_URL", "chrome://core/content/main.xhtml")

include("../toolkit/moz.configure")
