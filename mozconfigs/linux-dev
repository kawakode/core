# Build de développement Linux : rapide à compiler, sans LTO ni PGO.
# Utilisation : MOZCONFIG=$PWD/core/mozconfigs/linux-dev ./mach build
ac_add_options --enable-project=core
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-core-dev

ac_add_options --disable-debug
ac_add_options --enable-optimize
ac_add_options --disable-tests

. "$topsrcdir/core/mozconfigs/common"
