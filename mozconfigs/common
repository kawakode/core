# Options communes à tous les builds de Core.
# Voir /mnt/project-files/architecture/coquille-gecko.md, section 2.3.

# Composants dont Core n'a pas l'usage.
ac_add_options --disable-crashreporter
ac_add_options --disable-updater
ac_add_options --disable-parental-controls
ac_add_options --disable-legacy-profile-creation
ac_add_options --disable-system-extension-dirs
ac_add_options --disable-necko-wifi
ac_add_options --disable-webspeech
ac_add_options --disable-synth-speechd
ac_add_options --disable-profiling
ac_add_options --disable-real-time-tracing
# Aucune IA locale : ni ONNX Runtime, ni llama.cpp (retiré par patches/0002).
ac_add_options --without-onnx-runtime

# Gardés volontairement : EME (DRM), WebRTC, accessibilité, sandbox, jemalloc.
# WebDriver (remote/) aussi : les pages d'erreur de toolkit/ en dépendent
# (NetErrorChild importe chrome://remote/content/shared/AppInfo.sys.mjs).
ac_add_options --enable-eme=widevine
