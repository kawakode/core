# Build de distribution macOS Apple Silicon (arm64) compilé depuis Linux :
# LTO, sans PGO (le profilage demanderait de lancer Core sur un Mac).
# mach bootstrap récupère clang, le SDK macOS et, pour le .dmg, les outils
# hfsplus et dmg. Voir scripts/release/construire.sh et empaqueter.sh.
ac_add_options --enable-project=core
ac_add_options --target=aarch64-apple-darwin
ac_add_options --enable-bootstrap
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-core-macos-aarch64-release

ac_add_options --enable-release
ac_add_options --disable-debug
ac_add_options --enable-optimize
ac_add_options --enable-lto
ac_add_options --disable-tests
# Pas de symboles de débogage : ni crashreporter ni serveur de symboles pour
# s'en servir, et rustc n'a pas à garder la debuginfo de gkrust en mémoire.
ac_add_options --disable-debug-symbols
# Comme Firefox : la cible aarch64-apple-darwin vise sinon l'Apple A7 et se
# prive des instructions des puces M.
export CFLAGS="$CFLAGS -mcpu=apple-m1"
export CXXFLAGS="$CXXFLAGS -mcpu=apple-m1"

. "$topsrcdir/core/mozconfigs/common"
