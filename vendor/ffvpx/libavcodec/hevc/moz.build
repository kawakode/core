SOURCES += [
    'cabac.c',
    'data.c',
    'dsp.c',
    'filter.c',
    'hevcdec.c',
    'mvs.c',
    'parse.c',
    'pred.c',
    'ps.c',
    'refs.c',
    'sei.c',
]

LOCAL_INCLUDES += ['/media/ffvpx/libavcodec']

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
    LOCAL_INCLUDES += ['/media/mozva']

FINAL_LIBRARY = 'mozavcodec'
NoVisibilityFlags()

include('/media/ffvpx/ffvpxcommon.mozbuild')
