+  auto* objectProto = &cx->global()->getObjectPrototype().as<NativeObject>();
+  MOZ_ASSERT(objectProto->staticPrototype() == nullptr,
+             "Object.prototype has an immutable null [[Prototype]]");
+  return ProtoHasNoIndexedProps(objectProto);
