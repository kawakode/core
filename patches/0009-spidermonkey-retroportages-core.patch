diff --git a/js/src/jit-test/tests/JSON/stringify-toJSON-cache.js b/js/src/jit-test/tests/JSON/stringify-toJSON-cache.js
new file mode 100644
index 0000000000..a201aa4e11
--- /dev/null
+++ b/js/src/jit-test/tests/JSON/stringify-toJSON-cache.js
@@ -0,0 +1,30 @@
+// Adding toJSON to a prototype must invalidate cached missing-toJSON lookups.
+
+function testImpl(objStr, protoStr, expected, mutation) {
+  let g = newGlobal({sameCompartmentAs: this});
+  g.eval(`
+    let obj = ${objStr};
+    let proto = ${protoStr};
+    for (var i = 0; i < 100; i++) {
+      assertEq(JSONStringify(obj, "FastOnly"), '${expected}');
+    }
+    ${mutation}
+    assertEq(JSON.stringify(obj), '"called"');
+`)
+}
+
+function test(objStr, protoStr, expected) {
+  let defineDataProp = "proto.toJSON = () => 'called';";
+  let defineGetter = "Object.defineProperty(proto, 'toJSON', { get() { return () => 'called'; }});";
+  testImpl(objStr, protoStr, expected, defineDataProp);
+  testImpl(objStr, protoStr, expected, defineGetter);
+}
+
+
+test("{a: 1}", "Object.prototype", '{"a":1}');
+
+test("[1, 2]", "Array.prototype", '[1,2]');
+
+let objStr = "Object.create({}, {a: {value: 1, enumerable: true}})";
+let protoStr = "obj.__proto__";
+test(objStr, protoStr, '{"a":1}');
diff --git a/js/src/jit-test/tests/basic/object-spread-shape-reuse.js b/js/src/jit-test/tests/basic/object-spread-shape-reuse.js
new file mode 100644
index 0000000000..393d68a767
--- /dev/null
+++ b/js/src/jit-test/tests/basic/object-spread-shape-reuse.js
@@ -0,0 +1,337 @@
+// Object spread reuses |from|'s Shape or PropMap when the target is empty and
+// every property is a plain enumerable data property.
+
+function keys(o) {
+  return Object.keys(o).join(",");
+}
+
+function makeWide(n) {
+  var o = {};
+  for (var i = 0; i < n; i++) {
+    o["p" + i] = i;
+  }
+  return o;
+}
+
+// More properties than PropMap::Capacity, so |from|'s PropMap is a chain.
+for (var n of [1, 7, 8, 9, 16, 17, 40]) {
+  var from = makeWide(n);
+  var to = {...from};
+  assertEq(keys(to), keys(from));
+  assertEq(Object.keys(to).length, n);
+  for (var i = 0; i < n; i++) {
+    assertEq(to["p" + i], i);
+  }
+  assertEq(Object.getOwnPropertyDescriptor(to, "p0").enumerable, true);
+  assertEq(Object.getOwnPropertyDescriptor(to, "p0").writable, true);
+  assertEq(Object.getOwnPropertyDescriptor(to, "p0").configurable, true);
+}
+
+// The target literal's fixed-slot count is derived from its own syntactic
+// property count, so it usually differs from |from|'s. Both must work.
+function spreadPlusThree(o) {
+  return {...o, x: 1, y: 2, a: 3};
+}
+var src = {x: 9, y: 9, a: 9, b: 4, c: 5};
+for (var i = 0; i < 200; i++) {
+  var r = spreadPlusThree(src);
+  assertEq(keys(r), "x,y,a,b,c");
+  assertEq(r.x, 1);
+  assertEq(r.y, 2);
+  assertEq(r.a, 3);
+  assertEq(r.b, 4);
+  assertEq(r.c, 5);
+}
+
+// Non-enumerable properties must not be copied and must not be reused.
+var withNonEnum = {a: 1};
+Object.defineProperty(withNonEnum, "hidden", {value: 2, enumerable: false,
+                                              writable: true,
+                                              configurable: true});
+withNonEnum.b = 3;
+var copy = {...withNonEnum};
+assertEq(keys(copy), "a,b");
+assertEq("hidden" in copy, false);
+
+// Non-writable / non-configurable properties become plain data properties.
+var frozenish = {};
+Object.defineProperty(frozenish, "ro", {value: 1, enumerable: true,
+                                        writable: false, configurable: false});
+var thawed = {...frozenish};
+var desc = Object.getOwnPropertyDescriptor(thawed, "ro");
+assertEq(desc.writable, true);
+assertEq(desc.configurable, true);
+assertEq(desc.enumerable, true);
+
+// Symbol-keyed properties are copied and do not appear in Object.keys.
+var sym = Symbol("s");
+var withSym = {a: 1, [sym]: 2, b: 3};
+var symCopy = {...withSym};
+assertEq(keys(symCopy), "a,b");
+assertEq(symCopy[sym], 2);
+
+// An interesting symbol sets an ObjectFlag on |from|'s shape.
+var interesting = {a: 1, [Symbol.iterator]: 2, b: 3};
+var interestingCopy = {...interesting};
+assertEq(keys(interestingCopy), "a,b");
+assertEq(interestingCopy[Symbol.iterator], 2);
+
+// An own "__proto__" data property stays an own data property.
+var protoProp = {};
+Object.defineProperty(protoProp, "__proto__", {value: 1, enumerable: true,
+                                               writable: true,
+                                               configurable: true});
+var protoCopy = {...protoProp};
+assertEq(Object.getOwnPropertyDescriptor(protoCopy, "__proto__").value, 1);
+assertEq(Object.getPrototypeOf(protoCopy), Object.prototype);
+
+// Accessors on |from| force the slow path.
+var withGetter = {a: 1, get g() { return 5; }, b: 2};
+var getterCopy = {...withGetter};
+assertEq(keys(getterCopy), "a,g,b");
+assertEq(getterCopy.g, 5);
+assertEq(Object.getOwnPropertyDescriptor(getterCopy, "g").get, undefined);
+
+// Dictionary-mode sources still copy correctly.
+var dict = makeWide(12);
+delete dict.p3;
+var dictCopy = {...dict};
+assertEq(dictCopy.p3, undefined);
+assertEq(Object.keys(dictCopy).length, 11);
+
+// Rest destructuring with preceding bindings uses the excludedItems path,
+// which never reuses shapes.
+var {p0, p1, ...rest} = makeWide(10);
+assertEq(p0, 0);
+assertEq(Object.keys(rest).length, 8);
+assertEq(rest.p2, 2);
+
+// The target of a spread must be extensible and independent of |from|.
+var indep = makeWide(10);
+var indepCopy = {...indep};
+indepCopy.p0 = 99;
+assertEq(indep.p0, 0);
+Object.preventExtensions(indepCopy);
+assertEq(Object.isExtensible(indep), true);
+
+// A Date object with reserved slots as |from|.
+var dateSrc = new Date(1234567890000);
+dateSrc.a = 1;
+dateSrc.b = 2;
+var dateCopy = {...dateSrc};
+assertEq(keys(dateCopy), "a,b");
+assertEq(dateCopy.a, 1);
+assertEq(dateCopy.b, 2);
+
+// A rest pattern with no preceding bindings passes excludedItems === null, so
+// unlike the filtered form above it does reach the shape reuse path.
+var {...bareRest} = makeWide(10);
+assertEq(Object.keys(bareRest).length, 10);
+assertEq(bareRest.p0, 0);
+assertEq(bareRest.p9, 9);
+
+// |from|'s ObjectFlags must not reach the copy when they are more than
+// HasEnumerable: a non-extensible or used-as-prototype source still produces an
+// ordinary extensible copy.
+var preventedSrc = {a: 1, b: 2};
+Object.preventExtensions(preventedSrc);
+var preventedCopy = {...preventedSrc};
+assertEq(keys(preventedCopy), "a,b");
+preventedCopy.c = 3;
+assertEq(preventedCopy.c, 3);
+
+var usedAsProtoSrc = {a: 1, b: 2};
+Object.create(usedAsProtoSrc);
+var usedAsProtoCopy = {...usedAsProtoSrc};
+assertEq(keys(usedAsProtoCopy), "a,b");
+usedAsProtoCopy.c = 3;
+assertEq(usedAsProtoCopy.c, 3);
+
+// The target can have no own properties while already holding dense elements,
+// which the shape reuse must leave alone.
+var withIndex = {0: 1, ...{a: 2, b: 3}};
+assertEq(keys(withIndex), "0,a,b");
+assertEq(withIndex[0], 1);
+assertEq(withIndex.a, 2);
+assertEq(withIndex.b, 3);
+
+// A same-compartment cross-realm source can only reuse the PropMap, because the
+// BaseShape carries the realm. The copy must get this realm's Object.prototype.
+var otherRealm = newGlobal({sameCompartmentAs: this});
+var crossSrc = otherRealm.eval("({a: 1, b: 2, c: 3})");
+for (var i = 0; i < 20; i++) {
+  var crossCopy = {...crossSrc};
+  assertEq(keys(crossCopy), "a,b,c");
+  assertEq(crossCopy.c, 3);
+  assertEq(Object.getPrototypeOf(crossCopy), Object.prototype);
+}
+
+// Non-plain native sources take the other precondition branch. Arrays and typed
+// arrays expose their elements as own enumerable index properties; String
+// objects and arguments objects resolve index properties lazily.
+var arrCopy = {...[10, 20, 30]};
+assertEq(keys(arrCopy), "0,1,2");
+assertEq(arrCopy[1], 20);
+assertEq(Array.isArray(arrCopy), false);
+
+// An empty array has no dense elements and no enumerate hook, so unlike the
+// cases above it runs all the way to the property walk. Its only own property
+// is a non-enumerable "length", so nothing is copied.
+var emptyArrCopy = {...[]};
+assertEq(Object.keys(emptyArrCopy).length, 0);
+
+var taCopy = {...new Uint8Array([7, 8])};
+assertEq(keys(taCopy), "0,1");
+assertEq(taCopy[0], 7);
+
+var strCopy = {..."hey"};
+assertEq(keys(strCopy), "0,1,2");
+assertEq(strCopy[2], "y");
+assertEq(Object.hasOwn(strCopy, "length"), false);
+
+var boxedStrCopy = {...new String("hi")};
+assertEq(keys(boxedStrCopy), "0,1");
+assertEq(boxedStrCopy[1], "i");
+
+function argsSpread() {
+  return {...arguments};
+}
+var argsCopy = argsSpread("a", "b");
+assertEq(keys(argsCopy), "0,1");
+assertEq(argsCopy[1], "b");
+
+// Repeating a shape pair takes the cached path; the result must not differ
+// from the first, uncached one.
+var repeatSrc = {a: 1, b: 2, c: 3};
+var first = {...repeatSrc};
+for (var i = 0; i < 100; i++) {
+  var again = {...repeatSrc};
+  assertEq(keys(again), keys(first));
+  assertEq(again.a, 1);
+  assertEq(again.b, 2);
+  assertEq(again.c, 3);
+}
+
+// Alternating shape pairs defeat a one-entry cache. Results must stay correct.
+var altA = {q: 1, r: 2};
+var altB = {s: 3, t: 4, u: 5};
+for (var i = 0; i < 100; i++) {
+  var copyA = {...altA};
+  var copyB = {...altB};
+  assertEq(keys(copyA), "q,r");
+  assertEq(keys(copyB), "s,t,u");
+  assertEq(copyA.r, 2);
+  assertEq(copyB.u, 5);
+}
+
+// Spread and Object.assign disagree about an own __proto__ data property:
+// spread defines an own property, Object.assign goes through [[Set]] and hits
+// the Object.prototype setter. Neither may serve the other a cached shape.
+var protoSrc = {};
+var protoMarker = {tag: "own"};
+Object.defineProperty(protoSrc, "__proto__", {value: protoMarker,
+                                              enumerable: true, writable: true,
+                                              configurable: true});
+protoSrc.after = 1;
+for (var i = 0; i < 100; i++) {
+  var viaSpread = {...protoSrc};
+  assertEq(Object.hasOwn(viaSpread, "__proto__"), true);
+  assertEq(Object.getPrototypeOf(viaSpread), Object.prototype);
+  assertEq(viaSpread.after, 1);
+
+  var viaAssign = Object.assign({}, protoSrc);
+  assertEq(Object.hasOwn(viaAssign, "__proto__"), false);
+  assertEq(Object.getPrototypeOf(viaAssign), protoMarker);
+  assertEq(viaAssign.after, 1);
+}
+
+// Same, for a symbol-keyed property: spread reuses the shape, Object.assign
+// falls back. Interleaving them must not let either see the other's shape.
+var mixSym = Symbol("mix");
+var mixSrc = {m: 1, [mixSym]: 2, n: 3};
+for (var i = 0; i < 100; i++) {
+  var mixSpread = {...mixSrc};
+  assertEq(keys(mixSpread), "m,n");
+  assertEq(mixSpread[mixSym], 2);
+  assertEq(Reflect.ownKeys(mixSpread).length, 3);
+
+  var mixAssign = Object.assign({}, mixSrc);
+  assertEq(keys(mixAssign), "m,n");
+  assertEq(mixAssign[mixSym], 2);
+  assertEq(Reflect.ownKeys(mixAssign).length, 3);
+}
+
+// Interleaving a plain and a non-plain source must not let the shape cache
+// serve one for the other. An array with named properties and no dense elements
+// is the case that reaches the cache lookup at all.
+var namedArr = [];
+Object.defineProperty(namedArr, "u", {value: 7, enumerable: true,
+                                      writable: true, configurable: true});
+Object.defineProperty(namedArr, "v", {value: 8, enumerable: true,
+                                      writable: true, configurable: true});
+var plainSrc = {u: 1, v: 2};
+for (var i = 0; i < 100; i++) {
+  var p = {...plainSrc};
+  var a = {...namedArr};
+  assertEq(keys(p), "u,v");
+  assertEq(p.u, 1);
+  assertEq(keys(a), "u,v");
+  assertEq(a.u, 7);
+  assertEq(Array.isArray(a), false);
+}
+
+// A |from| whose properties have non-default flags cannot have its Shape or
+// PropMap reused.
+var nonDefaultSrc = {};
+Object.defineProperty(nonDefaultSrc, "a", {value: 1, enumerable: true,
+                                           writable: false,
+                                           configurable: true});
+Object.defineProperty(nonDefaultSrc, "b", {value: 2, enumerable: true,
+                                           writable: false,
+                                           configurable: true});
+for (var i = 0; i < 100; i++) {
+  var ndCopy = {...nonDefaultSrc};
+  assertEq(keys(ndCopy), "a,b");
+  assertEq(ndCopy.a, 1);
+  assertEq(ndCopy.b, 2);
+  var ndDesc = Object.getOwnPropertyDescriptor(ndCopy, "a");
+  assertEq(ndDesc.writable, true);
+  assertEq(ndDesc.configurable, true);
+  assertEq(ndDesc.enumerable, true);
+}
+
+// Same for a frozen source.
+var frozenSrc = Object.freeze({a: 1, b: 2, c: 3});
+for (var i = 0; i < 100; i++) {
+  var frozenCopy = {...frozenSrc};
+  assertEq(keys(frozenCopy), "a,b,c");
+  assertEq(frozenCopy.c, 3);
+  frozenCopy.d = 4;
+  assertEq(frozenCopy.d, 4);
+  assertEq(Object.getOwnPropertyDescriptor(frozenCopy, "a").writable, true);
+}
+
+// A source with a non-enumerable property must not be cached: |target| ends up
+// with fewer slots than |from|, so a cached entry would copy the wrong ones.
+var hiddenSrc = {a: 1};
+Object.defineProperty(hiddenSrc, "hidden", {value: 9, enumerable: false,
+                                            writable: true,
+                                            configurable: true});
+hiddenSrc.b = 2;
+for (var i = 0; i < 100; i++) {
+  var hiddenCopy = {...hiddenSrc};
+  assertEq(keys(hiddenCopy), "a,b");
+  assertEq("hidden" in hiddenCopy, false);
+  assertEq(hiddenCopy.a, 1);
+  assertEq(hiddenCopy.b, 2);
+}
+
+// An interesting symbol sets an ObjectFlag on |from|, so its Shape cannot be
+// reused either.
+var interestingSrc = {a: 1, [Symbol.iterator]: 2, b: 3};
+for (var i = 0; i < 100; i++) {
+  var interestingCopy = {...interestingSrc};
+  assertEq(keys(interestingCopy), "a,b");
+  assertEq(interestingCopy[Symbol.iterator], 2);
+  assertEq(Reflect.ownKeys(interestingCopy).length, 3);
+}
diff --git a/js/src/jit-test/tests/basic/object-spread-slow-path.js b/js/src/jit-test/tests/basic/object-spread-slow-path.js
new file mode 100644
index 0000000000..2772f06fd2
--- /dev/null
+++ b/js/src/jit-test/tests/basic/object-spread-slow-path.js
@@ -0,0 +1,165 @@
+// Object spread over sources that CopyDataPropertiesNative can't copy, so
+// they take the key-by-key path: getters, indexed properties, and targets
+// that already have properties.
+
+function keys(o) {
+  return Reflect.ownKeys(o).map(String).join(",");
+}
+
+function testGetters() {
+  var from, to;
+
+  // A getter can delete a later key.
+  from = {get a() { delete this.b; return 1; }, b: 2, c: 3};
+  to = {...from};
+  assertEq(keys(to), "a,c");
+
+  // A getter can make a later key non-enumerable.
+  from = {
+    get a() {
+      Object.defineProperty(this, "b", {enumerable: false});
+      return 1;
+    },
+    b: 2,
+    c: 3,
+  };
+  to = {...from};
+  assertEq(keys(to), "a,c");
+
+  // A getter can replace a later data property with an accessor.
+  from = {
+    get a() {
+      Object.defineProperty(this, "b", {get() { return "new"; }});
+      return 1;
+    },
+    b: 2,
+  };
+  to = {...from};
+  assertEq(to.b, "new");
+  assertEq(Object.getOwnPropertyDescriptor(to, "b").value, "new");
+
+  // Keys added by a getter aren't copied.
+  from = {get a() { this.z = 26; return 1; }, b: 2};
+  to = {...from};
+  assertEq(keys(to), "a,b");
+
+  // A getter that throws.
+  from = {x: 1, get y() { throw "boom"; }, z: 3};
+  try {
+    to = {...from};
+    assertEq(true, false);
+  } catch (e) {
+    assertEq(e, "boom");
+  }
+
+  // A setter without a getter copies undefined.
+  from = {set a(v) { throw "setter called"; }, b: 2};
+  to = {...from};
+  assertEq(keys(to), "a,b");
+  assertEq(to.a, undefined);
+  assertEq(Object.getOwnPropertyDescriptor(to, "a").writable, true);
+
+  // Non-enumerable and inherited getters aren't called.
+  var proto = {get inherited() { throw "inherited getter called"; }};
+  from = Object.create(proto);
+  Object.defineProperty(from, "hidden", {
+    get() { throw "hidden getter called"; },
+    enumerable: false,
+  });
+  from.own = 1;
+  Object.defineProperty(from, "g", {get() { return 7; }, enumerable: true});
+  to = {...from};
+  assertEq(keys(to), "own,g");
+  assertEq(to.g, 7);
+}
+
+function testIndexed() {
+  var from, to;
+
+  // Dense elements, string keys and a getter together.
+  from = {b: 1, get g() { return "g"; }};
+  from[1] = "one";
+  from[0] = "zero";
+  to = {...from};
+  assertEq(keys(to), "0,1,b,g");
+  assertEq(to[0], "zero");
+  assertEq(to.g, "g");
+
+  // Holes aren't copied.
+  to = {...[1, , 3]};
+  assertEq(keys(to), "0,2");
+
+  // A non-enumerable element isn't copied.
+  from = [10, 20, 30];
+  Object.defineProperty(from, 1, {enumerable: false});
+  to = {...from};
+  assertEq(keys(to), "0,2");
+
+  // Typed arrays and String objects with extra properties.
+  from = new Int8Array([1, 2]);
+  from.extra = "e";
+  to = {...from};
+  assertEq(keys(to), "0,1,extra");
+  assertEq(to[1], 2);
+
+  from = new String("ab");
+  from.extra = "e";
+  from[5] = "five";
+  to = {...from};
+  assertEq(keys(to), "0,1,5,extra");
+  assertEq(to[1], "b");
+  assertEq(to[5], "five");
+
+  // Arguments objects.
+  function mapped(a, b) {
+    delete arguments[0];
+    return {...arguments};
+  }
+  to = mapped(1, 2, 3);
+  assertEq(keys(to), "1,2");
+  assertEq(to[2], 3);
+
+  function unmapped(a, b) {
+    "use strict";
+    arguments.extra = "e";
+    return {...arguments};
+  }
+  to = unmapped(1, 2);
+  assertEq(keys(to), "0,1,extra");
+}
+
+function testNonEmptyTarget() {
+  var from, to, set;
+
+  // A colliding key is overwritten in place.
+  from = {a: 2, get b() { return 3; }};
+  to = {c: 0, a: 1, ...from};
+  assertEq(keys(to), "c,a,b");
+  assertEq(to.a, 2);
+
+  // A colliding accessor on the target becomes a data property.
+  to = {get a() { return "target"; }, ...from};
+  assertEq(Object.getOwnPropertyDescriptor(to, "a").value, 2);
+  assertEq(Object.getOwnPropertyDescriptor(to, "a").get, undefined);
+
+  // Colliding integer keys.
+  from = ["x", "y"];
+  to = {0: "t0", 5: "t5", ...from};
+  assertEq(keys(to), "0,1,5");
+  assertEq(to[0], "x");
+
+  // Copying defines, so setters on the prototype don't run.
+  set = false;
+  var proto = {set a(v) { set = true; }};
+  from = {a: 1, get b() { return 2; }};
+  to = {__proto__: proto, ...from};
+  assertEq(set, false);
+  assertEq(Object.getOwnPropertyDescriptor(to, "a").value, 1);
+  to = {__proto__: proto, x: 0, ...from};
+  assertEq(set, false);
+  assertEq(keys(to), "x,a,b");
+}
+
+testGetters();
+testIndexed();
+testNonEmptyTarget();
diff --git a/js/src/jit-test/tests/cacheir/bound-function-bailout.js b/js/src/jit-test/tests/cacheir/bound-function-bailout.js
new file mode 100644
index 0000000000..a016bb452a
--- /dev/null
+++ b/js/src/jit-test/tests/cacheir/bound-function-bailout.js
@@ -0,0 +1,111 @@
+// |jit-test| --fast-warmup; --no-threads
+
+// Bailing out from inside a call to a bound function must reconstruct |this| and
+// the full argument list (bound arguments followed by actual arguments), for
+// each combination of bound and actual argument counts.
+//
+// The bailout has to happen while the target is inlined into its caller, so it
+// is triggered by reshaping |bail| after the callers are compiled: the shape
+// guard for |bail.x| then fails inside the inlined target.
+//
+// Note: the call sites below are deliberately fixed-arity. Spread calls are not
+// optimized by CallIRGenerator::tryAttachBoundFunction, so a spread call site
+// would not exercise the bound function stubs at all.
+
+const obj = {tag: "obj"};
+const bail = {x: 1};
+
+// No bound arguments.
+function t0(a, b) {
+  const r = bail.x;
+  assertEq(this, obj);
+  assertEq(a, 10);
+  assertEq(b, 11);
+  return r;
+}
+const b0 = t0.bind(obj);
+function callB0() { return b0(10, 11); }
+
+// One bound argument.
+function t1(a, b, c) {
+  const r = bail.x;
+  assertEq(this, obj);
+  assertEq(a, 1);
+  assertEq(b, 10);
+  assertEq(c, 11);
+  return r;
+}
+const b1 = t1.bind(obj, 1);
+function callB1() { return b1(10, 11); }
+
+// MaxInlineBoundArgs bound arguments.
+function t3(a, b, c, d, e) {
+  const r = bail.x;
+  assertEq(this, obj);
+  assertEq(a, 1);
+  assertEq(b, 2);
+  assertEq(c, 3);
+  assertEq(d, 10);
+  assertEq(e, 11);
+  return r;
+}
+const b3 = t3.bind(obj, 1, 2, 3);
+function callB3() { return b3(10, 11); }
+
+// More than MaxInlineBoundArgs, so the bound arguments live in an array.
+function t4(a, b, c, d, e, f) {
+  const r = bail.x;
+  assertEq(this, obj);
+  assertEq(a, 1);
+  assertEq(b, 2);
+  assertEq(c, 3);
+  assertEq(d, 4);
+  assertEq(e, 10);
+  assertEq(f, 11);
+  return r;
+}
+const b4 = t4.bind(obj, 1, 2, 3, 4);
+function callB4() { return b4(10, 11); }
+
+// Fewer arguments than the target's arity.
+function tUnderflow(a, b, c, d) {
+  const r = bail.x;
+  assertEq(this, obj);
+  assertEq(a, 1);
+  assertEq(b, undefined);
+  assertEq(c, undefined);
+  assertEq(d, undefined);
+  return r;
+}
+const bUnderflow = tUnderflow.bind(obj, 1);
+function callBUnderflow() { return bUnderflow(); }
+
+// More arguments than the target's arity. Reading |arguments| here forces the
+// overflow-argument path in InlineFrameIterator::readFrameArgsAndLocals.
+function tOverflow(a) {
+  const r = bail.x;
+  assertEq(this, obj);
+  assertEq(a, 1);
+  assertEq(arguments.length, 4);
+  assertEq(arguments[1], 2);
+  assertEq(arguments[2], 10);
+  assertEq(arguments[3], 11);
+  return r;
+}
+const bOverflow = tOverflow.bind(obj, 1, 2);
+function callBOverflow() { return bOverflow(10, 11); }
+
+const cases = [callB0, callB1, callB3, callB4, callBUnderflow, callBOverflow];
+
+with ({}) {}
+for (var i = 0; i < 200; i++) {
+  for (var fn of cases) {
+    assertEq(fn(), 1);
+  }
+}
+
+bail.trigger = true;
+
+for (var fn of cases) {
+  assertEq(fn(), 1);
+}
diff --git a/js/src/jit-test/tests/cacheir/bound-function-stack-walk.js b/js/src/jit-test/tests/cacheir/bound-function-stack-walk.js
new file mode 100644
index 0000000000..4a1fa22ed1
--- /dev/null
+++ b/js/src/jit-test/tests/cacheir/bound-function-stack-walk.js
@@ -0,0 +1,40 @@
+// |jit-test| --fast-warmup; --no-threads
+
+// Walking the stack from inside a call to a bound function must report the
+// target function, not the bound function. If the bound function ends up in the
+// caller frame's callee slot, InlineFrameIterator::findNextFrame casts it to
+// JSFunction, which is a bad cast.
+
+const obj = {};
+
+function innerStack(a) {
+  return new Error("stack").stack;
+}
+const boundStack = innerStack.bind(obj);
+function outerStack() { return boundStack(1); }
+
+for (let i = 0; i < 500; i++) {
+  const stack = outerStack();
+  assertEq(stack.includes("innerStack"), true);
+  assertEq(stack.includes("outerStack"), true);
+}
+
+// Same thing, but the stack is walked while unwinding for an exception.
+function innerThrow(a) {
+  throw new Error("thrown");
+}
+const boundThrow = innerThrow.bind(obj);
+function outerThrow() {
+  try {
+    boundThrow(1);
+  } catch (e) {
+    return e.stack;
+  }
+  return "no throw";
+}
+
+for (let i = 0; i < 500; i++) {
+  const stack = outerThrow();
+  assertEq(stack.includes("innerThrow"), true);
+  assertEq(stack.includes("outerThrow"), true);
+}
diff --git a/js/src/jit-test/tests/cacheir/bound-function-trial-inlining.js b/js/src/jit-test/tests/cacheir/bound-function-trial-inlining.js
new file mode 100644
index 0000000000..5413dfc671
--- /dev/null
+++ b/js/src/jit-test/tests/cacheir/bound-function-trial-inlining.js
@@ -0,0 +1,62 @@
+// |jit-test| --inlining-entry-threshold=1; --trial-inlining-warmup-threshold=50; --baseline-warmup-threshold=200; --ion-warmup-threshold=1000; --no-threads; --no-cgc; --baseline-batching=on
+
+// Verify that calls to bound functions are actually trial-inlined, and that the
+// cases we don't support are actually rejected.
+
+let options = getJitCompilerOptions();
+if (!options['blinterp.enable'] ||
+    !options['baseline.enable'] ||
+    options['ion.warmup.trigger'] <= 100) {
+  print("Unsupported jit options");
+  quit();
+}
+
+const obj = {tag: "obj"};
+
+// The target's IC is made polymorphic below so that we get trial inlining
+// instead of monomorphic inlining. See ShouldUseMonomorphicInlining.
+function target(o) {
+  return o.x;
+}
+const bound = target.bind(obj);
+
+function caller(o) {
+  return bound(o);
+}
+
+function testInlined() {
+  with ({}) {}
+  for (var i = 0; i < 50; i++) {
+    assertEq(caller({x: 1}), 1);
+    assertEq(caller({a: 0, x: 1}), 1);
+  }
+  let ICs = disblic(caller);
+  if (/;   IR:/.test(ICs)) { // Only assert if we can actually dump IR.
+    assertEq(/CallInlinedBoundFunction/.test(ICs), true);
+  }
+}
+testInlined();
+
+// Bound arguments are not supported yet: the stub must stay unchanged.
+function target2(a, o) {
+  return a + o.x;
+}
+const bound2 = target2.bind(obj, 1);
+
+function caller2(o) {
+  return bound2(o);
+}
+
+function testNotInlined() {
+  with ({}) {}
+  for (var i = 0; i < 50; i++) {
+    assertEq(caller2({x: 1}), 2);
+    assertEq(caller2({a: 0, x: 1}), 2);
+  }
+  let ICs = disblic(caller2);
+  if (/;   IR:/.test(ICs)) {
+    assertEq(/CallInlinedBoundFunction/.test(ICs), false);
+    assertEq(/CallBoundScriptedFunction/.test(ICs), true);
+  }
+}
+testNotInlined();
diff --git a/js/src/jit-test/tests/fields/inline-zero-fields.js b/js/src/jit-test/tests/fields/inline-zero-fields.js
new file mode 100644
index 0000000000..0c3ad680a5
--- /dev/null
+++ b/js/src/jit-test/tests/fields/inline-zero-fields.js
@@ -0,0 +1,89 @@
+// |jit-test| --setpref=experimental.inline_simple_field_initializers=true
+
+class Lazy {
+  constructor() { this.zeta = 1; }
+  alphaField = 0;
+  bravoField = 0;
+}
+assertEq(JSON.stringify(new Lazy()), '{"alphaField":0,"bravoField":0,"zeta":1}');
+
+class Default { alphaField = 0; bravoField = 0; }
+assertEq(JSON.stringify(new Default()), '{"alphaField":0,"bravoField":0}');
+
+class Derived extends Default { charlieField = 0; }
+assertEq(JSON.stringify(new Derived()),
+         '{"alphaField":0,"bravoField":0,"charlieField":0}');
+
+class ArrowSuper extends Default {
+  charlieField = 0;
+  constructor() { const f = () => super(); f(); }
+}
+assertEq(JSON.stringify(new ArrowSuper()),
+         '{"alphaField":0,"bravoField":0,"charlieField":0}');
+
+class Private { x = 0; #y = 0; get y() { return this.#y; } }
+assertEq(new Private().y, 0);
+
+// Private names that nothing else in the class reads.
+class PrivateUnused { alphaField = 0; #bravo = 0; #charlie = 0; }
+assertEq(JSON.stringify(new PrivateUnused()), '{"alphaField":0}');
+
+class PrivateOnly {
+  #alpha = 0;
+  #bravo = 0;
+  static has(o) { return #alpha in o && #bravo in o; }
+  constructor() { this.z = 1; }
+}
+assertEq(PrivateOnly.has(new PrivateOnly()), true);
+assertEq(PrivateOnly.has({}), false);
+
+class PrivateDefault { #alpha = 0; static has(o) { return #alpha in o; } }
+assertEq(PrivateDefault.has(new PrivateDefault()), true);
+
+// A class with a private method has a private brand and isn't inlined.
+class PrivateMethod { #alpha = 0; #m() { return 1; } get v() { return this.#m() + this.#alpha; } }
+assertEq(new PrivateMethod().v, 1);
+
+var key = "computed";
+class Computed { alpha = 0; [key] = 0; }
+assertEq(JSON.stringify(new Computed()), '{"alpha":0,"computed":0}');
+
+class Index { 1 = 0; alpha = 0; }
+assertEq(JSON.stringify(new Index()), '{"1":0,"alpha":0}');
+
+class Many { a0=0;a1=0;a2=0;a3=0;a4=0;a5=0;a6=0;a7=0;a8=0;a9=0; }
+assertEq(Object.keys(new Many()).length, 10);
+
+// The functions and the class constructors are compiled lazily, then
+// delazified when called.
+let g = newGlobal({newCompartment: true});
+g.evaluate(`
+    function makePublic() {
+        class C { alphaField = 0; bravoField = 0; }
+        return new C();
+    }
+    function makePrivate() {
+        class C { #alpha = 0; #bravo = 0; static has(o) { return #bravo in o; } }
+        return C.has(new C());
+    }
+    function makeExplicit() {
+        class C {
+            constructor() { this.zeta = 1; }
+            alphaField = 0;
+            bravoField = 0;
+        }
+        return new C();
+    }
+`);
+
+function checkDelazified() {
+  assertEq(JSON.stringify(g.makePublic()), '{"alphaField":0,"bravoField":0}');
+  assertEq(g.makePrivate(), true);
+  assertEq(JSON.stringify(g.makeExplicit()),
+           '{"alphaField":0,"bravoField":0,"zeta":1}');
+}
+
+checkDelazified();
+finishgc();
+startgc(0, 'shrinking');
+checkDelazified();
diff --git a/js/src/jit-test/tests/fuses/protos-have-no-indexed-props-1.js b/js/src/jit-test/tests/fuses/protos-have-no-indexed-props-1.js
new file mode 100644
index 0000000000..c949ed4eee
--- /dev/null
+++ b/js/src/jit-test/tests/fuses/protos-have-no-indexed-props-1.js
@@ -0,0 +1,87 @@
+// Test the VM operations that pop ObjectProtoHasNoIndexedPropsFuse and
+// ArrayProtoHasNoIndexedPropsFuse.
+
+function test(code, objectIntact, arrayIntact) {
+  var g = newGlobal();
+  g.evaluate(`
+    function check(objectIntact, arrayIntact) {
+      var state = getFuseState();
+      assertEq(state.ObjectProtoHasNoIndexedPropsFuse.intact, objectIntact);
+      assertEq(state.ArrayProtoHasNoIndexedPropsFuse.intact, arrayIntact);
+    }
+    check(true, true);
+    ${code}
+    check(${objectIntact}, ${arrayIntact});
+  `);
+}
+
+// Popping the Object.prototype fuse also pops the Array.prototype fuse.
+function testPopsObject(code) {
+  test(code, false, false);
+}
+function testPopsArray(code) {
+  test(code, true, false);
+}
+function testDoesNotPop(code) {
+  test(code, true, true);
+}
+
+// Dense elements.
+testPopsArray("Array.prototype[0] = 1;");
+testPopsObject("Object.prototype[0] = 1;");
+testPopsArray("Array.prototype[3] = 1;");
+testPopsArray("Object.defineProperty(Array.prototype, 0, {value: 1});");
+testPopsObject("Object.defineProperty(Object.prototype, 0, {value: 1});");
+testPopsArray("Array.prototype.push(1);");
+testPopsObject("Array.prototype.push.call(Object.prototype, 1);");
+testPopsArray("Array.prototype.unshift(1);");
+testPopsArray("Array.prototype.splice(0, 0, 1, 2);");
+testPopsArray("Array.prototype.fill.call(Object.assign(Array.prototype, {length: 2}), 0);");
+testPopsArray("Reflect.set(Array.prototype, 0, 1);");
+testPopsObject("Object.assign(Object.prototype, [1, 2]);");
+testPopsObject("class B { constructor() { return Object.prototype; } } class D extends B { 0 = 1; } new D();");
+testPopsArray("class B { constructor() { return Array.prototype; } } class D extends B { [1] = 1; } new D();");
+
+// Sparse indexed properties.
+testPopsArray("Array.prototype[1e9] = 1;");
+testPopsObject("Object.prototype[4294967294] = 1;");
+testPopsObject("Object.defineProperty(Object.prototype, 0, {get() { return 1; }});");
+testPopsArray("Object.defineProperty(Array.prototype, 2, {get() { return 1; }});");
+testPopsObject("Object.prototype.__defineSetter__(1, function() {});");
+
+// Prototype changes.
+testPopsArray("Object.setPrototypeOf(Array.prototype, null);");
+testPopsArray("Object.setPrototypeOf(Array.prototype, {});");
+testPopsArray("Array.prototype.__proto__ = Object.create(Object.prototype);");
+
+// Popping the Array.prototype fuse doesn't affect the Object.prototype fuse.
+testPopsArray("Array.prototype[0] = 1; Array.prototype[1e9] = 2; Object.setPrototypeOf(Array.prototype, null);");
+testPopsObject("Array.prototype[0] = 1; Object.prototype[0] = 1;");
+
+// Operations that don't add indexed properties to the prototypes.
+testDoesNotPop("Array.prototype.length = 10;");
+testDoesNotPop("Array.prototype[-1] = 1; Object.prototype[4294967295] = 1;");
+testDoesNotPop("Object.prototype.foo = 1; Array.prototype.bar = 2;");
+testDoesNotPop("Array.prototype.push.call(Array.prototype);");
+testDoesNotPop("var arr = []; arr[0] = 1; arr.push(2); var obj = {}; obj[0] = 1;");
+testDoesNotPop("Object.freeze(Array.prototype); Object.freeze(Object.prototype);");
+testDoesNotPop("Object.preventExtensions(Array.prototype);");
+testDoesNotPop("Object.setPrototypeOf(Object.prototype, null);");
+testDoesNotPop("try { Object.setPrototypeOf(Object.prototype, {}); } catch {}");
+testDoesNotPop("Object.setPrototypeOf(Array.prototype, Object.prototype);");
+testDoesNotPop("Array.prototype.indexOf(1); Array.prototype.slice(); Array.prototype.concat([1]);");
+testDoesNotPop("Object.setPrototypeOf(Object.create(Array.prototype), {})[0] = 1;");
+
+// Indexed properties on prototypes in another realm don't affect this realm.
+var g = newGlobal({sameCompartmentAs: this});
+assertEq(getFuseState().ArrayProtoHasNoIndexedPropsFuse.intact, true);
+g.Array.prototype[0] = 1;
+assertEq(g.getFuseState().ArrayProtoHasNoIndexedPropsFuse.intact, false);
+assertEq(g.getFuseState().ObjectProtoHasNoIndexedPropsFuse.intact, true);
+assertEq(getFuseState().ArrayProtoHasNoIndexedPropsFuse.intact, true);
+g = newGlobal({sameCompartmentAs: this});
+g.Object.prototype[1e9] = 1;
+assertEq(g.getFuseState().ObjectProtoHasNoIndexedPropsFuse.intact, false);
+assertEq(g.getFuseState().ArrayProtoHasNoIndexedPropsFuse.intact, false);
+assertEq(getFuseState().ObjectProtoHasNoIndexedPropsFuse.intact, true);
+assertEq(getFuseState().ArrayProtoHasNoIndexedPropsFuse.intact, true);
diff --git a/js/src/jit-test/tests/fuses/protos-have-no-indexed-props-2.js b/js/src/jit-test/tests/fuses/protos-have-no-indexed-props-2.js
new file mode 100644
index 0000000000..511b18e6e0
--- /dev/null
+++ b/js/src/jit-test/tests/fuses/protos-have-no-indexed-props-2.js
@@ -0,0 +1,55 @@
+// |jit-test| --fast-warmup
+
+function testMegamorphic(proto) {
+  var g = newGlobal();
+  g.evaluate(`
+    function setElem(o, i, v) {
+      o[i] = v;
+    }
+    function getElem(o, i) {
+      return o[i];
+    }
+    function push(a, v) {
+      return a.push(v);
+    }
+    var objs = [];
+    for (var i = 0; i < 20; i++) {
+      var o = {};
+      o["p" + i] = i;
+      objs.push(o);
+      var a = [];
+      a["q" + i] = i;
+      objs.push(a);
+    }
+    for (var i = 0; i < 100; i++) {
+      for (var o of objs) {
+        setElem(o, 0, i);
+        assertEq(getElem(o, 1), undefined);
+        if (Array.isArray(o)) {
+          push(o, i);
+          o.length = 1;
+        }
+      }
+    }
+    var state = getFuseState();
+    assertEq(state.ObjectProtoHasNoIndexedPropsFuse.intact, true);
+    assertEq(state.ArrayProtoHasNoIndexedPropsFuse.intact, true);
+
+    if (${proto} === Array.prototype) {
+      push(Array.prototype, "x");
+    }
+    setElem(${proto}, 1, "x");
+
+    state = getFuseState();
+    assertEq(state.ObjectProtoHasNoIndexedPropsFuse.intact,
+             ${proto} !== Object.prototype);
+    assertEq(state.ArrayProtoHasNoIndexedPropsFuse.intact, false);
+    for (var o of objs) {
+      var expected = (${proto} === Object.prototype || Array.isArray(o))
+                     ? "x" : undefined;
+      assertEq(getElem(o, 1), expected);
+    }
+  `);
+}
+testMegamorphic("Array.prototype");
+testMegamorphic("Object.prototype");
diff --git a/js/src/jit-test/tests/fuses/protos-have-no-indexed-props-3.js b/js/src/jit-test/tests/fuses/protos-have-no-indexed-props-3.js
new file mode 100644
index 0000000000..a28290f5a8
--- /dev/null
+++ b/js/src/jit-test/tests/fuses/protos-have-no-indexed-props-3.js
@@ -0,0 +1,119 @@
+// |jit-test| --fast-warmup; --no-threads
+
+// Test element hole reads optimized with the no-indexed-properties fuses return
+// the correct value after the fuses are popped.
+
+function test(popCode, expectedArr, expectedObj) {
+  var g = newGlobal();
+  g.evaluate(`
+    function getHole(a, i) {
+      return a[i];
+    }
+    function hasHole(a, i) {
+      return i in a;
+    }
+    function getSparse(a, i) {
+      return a[i];
+    }
+    function getArgs(i) {
+      return arguments[i];
+    }
+    function hasArgs(i) {
+      return i in arguments;
+    }
+    function run(expectedArr, expectedObj) {
+      var arr = [0, , 2];
+      var obj = {0: 0};
+      var sparseArr = [];
+      sparseArr[10000] = 1;
+      var sparseObj = {};
+      sparseObj[10000] = 1;
+      for (var i = 0; i < 200; i++) {
+        assertEq(getHole(arr, 1), expectedArr);
+        assertEq(getHole(obj, 1), expectedObj);
+        assertEq(hasHole(arr, 1), expectedArr !== undefined);
+        assertEq(hasHole(obj, 1), expectedObj !== undefined);
+        assertEq(getSparse(sparseArr, 1), expectedArr);
+        assertEq(getSparse(sparseObj, 1), expectedObj);
+        assertEq(getArgs(1), expectedObj);
+        assertEq(hasArgs(1), expectedObj !== undefined);
+      }
+    }
+    run(undefined, undefined);
+    assertEq(getFuseState().ObjectProtoHasNoIndexedPropsFuse.intact, true);
+    assertEq(getFuseState().ArrayProtoHasNoIndexedPropsFuse.intact, true);
+    ${popCode}
+    assertEq(getFuseState().ObjectProtoHasNoIndexedPropsFuse.intact,
+             ${expectedObj === undefined});
+    assertEq(getFuseState().ArrayProtoHasNoIndexedPropsFuse.intact, false);
+    run(${expectedArr}, ${expectedObj});
+  `);
+}
+
+test(`Object.prototype[1] = 1;`, 1, 1);
+test(`Object.defineProperty(Object.prototype, 1, {get() { return 2; }});`, 2, 2);
+test(`Object.prototype[1e9] = 3; Object.prototype[1] = 3;`, 3, 3);
+test(`Array.prototype[1] = 4;`, 4, undefined);
+test(`Array.prototype.push(0, 5);`, 5, undefined);
+test(`Array.prototype[1e9] = 6; Array.prototype[1] = 6;`, 6, undefined);
+test(`Object.setPrototypeOf(Array.prototype, {1: 7});`, 7, undefined);
+
+// Test receivers with a prototype chain that reaches one of the fuse-protected
+// prototypes after one or more other prototypes.
+function testProtoChain(popCode, expected, objectIntact, arrayIntact) {
+  var g = newGlobal();
+  g.evaluate(`
+    class C {
+      constructor() {
+        this[0] = 0;
+      }
+    }
+    class D extends C {}
+    class MyArray extends Array {}
+    function getHole(o, i) {
+      return o[i];
+    }
+    function hasHole(o, i) {
+      return i in o;
+    }
+    function run(expected) {
+      for (var i = 0; i < 200; i++) {
+        var c = new C();
+        assertEq(getHole(c, 1), expected);
+        assertEq(hasHole(c, 1), expected !== undefined);
+        var d = new D();
+        assertEq(getHole(d, 1), expected);
+        assertEq(hasHole(d, 1), expected !== undefined);
+        var a = new MyArray();
+        a[0] = 0;
+        assertEq(getHole(a, 1), expected);
+        assertEq(hasHole(a, 1), expected !== undefined);
+      }
+    }
+    run(undefined);
+    ${popCode}
+    assertEq(getFuseState().ObjectProtoHasNoIndexedPropsFuse.intact,
+             ${objectIntact});
+    assertEq(getFuseState().ArrayProtoHasNoIndexedPropsFuse.intact,
+             ${arrayIntact});
+    run(${expected});
+  `);
+}
+
+// Pop the fuses.
+testProtoChain(`Object.prototype[1] = 1;`, 1, false, false);
+testProtoChain(`Array.prototype[1] = 2; C.prototype[1] = 2;`, 2, true, false);
+
+// Add indexed properties to prototypes that aren't covered by the fuses. The
+// fuses stay intact so the shape guards for these prototypes must fail.
+testProtoChain(`C.prototype[1] = 3; MyArray.prototype[1] = 3;`, 3, true, true);
+testProtoChain(`Object.defineProperty(C.prototype, 1, {get() { return 4; }});
+                Object.defineProperty(MyArray.prototype, 1, {get() { return 4; }});`,
+               4, true, true);
+testProtoChain(`Object.setPrototypeOf(C.prototype, {1: 5});
+                Object.setPrototypeOf(MyArray.prototype, [, 5]);`,
+               5, true, true);
+
+// No indexed properties are added.
+testProtoChain(`C.prototype.foo = 1; MyArray.prototype.bar = 2;`, undefined,
+               true, true);
