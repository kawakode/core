include("/toolkit/toolkit.mozbuild")

DIRS += ["/%s" % CONFIG["MOZ_BRANDING_DIRECTORY"]]

# Comme pour Firefox, l'application vient en dernier pour être empaquetée
# correctement sur Mac.
DIRS += ["/core"]
